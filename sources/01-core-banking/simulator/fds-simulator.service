[Unit]
Description=FDS Core Banking replay generator
After=network-online.target
Wants=network-online.target

[Service]
User=fds-sim
Group=fds-sim
EnvironmentFile=/etc/fds-simulator.env
# libpq looks for a client cert at $HOME/.postgresql/postgresql.crt. The service user has no home
# and ProtectHome hides /home, which libpq reports as "Permission denied" instead of skipping.
# Pointing HOME at the runtime dir makes that path simply absent.
Environment=HOME=/run/fds-simulator
RuntimeDirectory=fds-simulator
RuntimeDirectoryMode=0700
# "+" = run as root, outside the sandbox below. Invoked via bash because s3 sync does not keep the exec bit.
ExecStartPre=+/bin/bash /opt/fds/core-banking/simulator/fetch-secrets.sh
ExecStart=/opt/fds/venv-simulator/bin/python -u /opt/fds/core-banking/simulator/generator.py
Restart=always
RestartSec=10
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
