[global]
repo1-type=s3
repo1-s3-bucket=__BACKUP_BUCKET__
repo1-s3-region=ap-southeast-1
repo1-s3-endpoint=s3.ap-southeast-1.amazonaws.com
repo1-s3-key-type=auto
repo1-path=/pgbackrest/core-banking
repo1-retention-full=2
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=__CIPHER_PASS__
compress-type=zst
compress-level=3
process-max=2
start-fast=y
delta=y
archive-async=y
spool-path=/var/spool/pgbackrest
log-level-console=info
log-level-file=detail

[core-banking]
pg1-path=/pgdata/17/main
pg1-socket-path=/var/run/postgresql
